generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  email               String               @unique
  cpf                 String               @unique
  telefone            String
  dataNascimento      DateTime             @db.Timestamptz(6)
  password            String
  role                String
  googleId            String?
  currentSessionId    String?
  image               String?
  address             String?
  emailVerified       DateTime?            @db.Timestamp(6)
  agendamentos        Agendamento[]
  BookableSlot        BookableSlot[]
  passwordResetTokens PasswordResetToken[]
}

model Agendamento {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                Int
  dataHora              DateTime       @db.Timestamptz(6)
  status                String
  motivoConsulta        String
  googleCalendarEventId String?
  user                  User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  BookableSlot          BookableSlot[]
  Prontuario            Prontuario[]
  Recomendacao          Recomendacao[]
}

model BookableSlot {
  id            Int          @id @default(autoincrement())
  dataHora      DateTime     @db.Timestamptz(6)
  disponivel    Boolean
  userId        Int?
  agendamentoId String?      @db.Uuid
  Agendamento   Agendamento? @relation(fields: [agendamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User          User?        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HorarioAtuacao {
  id           Int     @id @default(autoincrement())
  horaInicio   String
  horaFim      String
  diaDaSemana  Int     @default(0)
  almocoInicio String?
  almocoFim    String?
}

model HorarioBloqueado {
  id             Int      @id @default(autoincrement())
  dataHoraInicio DateTime @db.Timestamptz(6)
  dataHoraFim    DateTime @db.Timestamptz(6)
}

model DisponibilidadeDiaria {
  id           Int      @id @default(autoincrement())
  data         DateTime @unique @db.Date
  horaInicio   String
  horaFim      String
  almocoInicio String?
  almocoFim    String?
}

model Prontuario {
  id            Int         @id @default(autoincrement())
  agendamentoId String      @db.Uuid
  texto         String
  Agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Recomendacao {
  id            Int         @id @default(autoincrement())
  agendamentoId String      @db.Uuid
  texto         String
  Agendamento   Agendamento @relation(fields: [agendamentoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}