generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String
  email               String               @unique
  cpf                 String               @unique
  telefone            String
  dataNascimento      DateTime             @db.Timestamptz(6)
  password            String
  role                String
  googleId            String?
  currentSessionId    String?
  image               String?
  address             String?
  emailVerified       DateTime?            @db.Timestamp(6)
  appointments        Agendamento[]
  BookableSlot        BookableSlot[]
  passwordResetTokens PasswordResetToken[]
  lastLogin           DateTime?            @db.Timestamptz(6)
  emailNotifications  Boolean              @default(true)
  smsNotifications    Boolean              @default(false)
  whatsappNotifications Boolean            @default(false)
}

model Agendamento {
  id             String    @id @default(uuid()) @db.Uuid // Adicionado @db.Uuid
  dataHora       DateTime // Substituído date e time por dataHora
  status         String
  protocolCode   String    @unique @default(cuid())
  patientId      Int
  user           User      @relation(fields: [patientId], references: [id])
  bookableSlotId String?   @unique
  bookableSlot   BookableSlot? @relation(fields: [bookableSlotId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model BookableSlot {
  id            String       @id @default(uuid())
  dataHora      DateTime     @db.Timestamptz(6)
  disponivel    Boolean
  userId        Int?
  agendamentoId String?      @unique
  Agendamento   Agendamento? // Removido fields e references
  User          User?        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HorarioAtuacao {
  id           Int     @id @default(autoincrement())
  horaInicio   String
  horaFim      String
  diaDaSemana  Int     @default(0)
  almocoInicio String?
  almocoFim    String?
}

model HorarioBloqueado {
  id             Int      @id @default(autoincrement())
  dataHoraInicio DateTime @db.Timestamptz(6)
  dataHoraFim    DateTime @db.Timestamptz(6)
}

model DisponibilidadeDiaria {
  id           Int      @id @default(autoincrement())
  data         DateTime @unique @db.Date
  horaInicio   String
  horaFim      String
  almocoInicio String?
  almocoFim    String?
}

model Prontuario {
  id            Int         @id @default(autoincrement())
  agendamentoId String      @unique // Removido @db.Uuid
  texto         String
}

model Recomendacao {
  id            Int         @id @default(autoincrement())
  agendamentoId String      @unique // Removido @db.Uuid
  texto         String
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}