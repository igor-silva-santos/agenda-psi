generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  cpf                 String               @unique
  telefone            String
  dataNascimento      DateTime             @db.Timestamptz(6)
  password            String? // Senha agora é opcional, para logins sociais
  role                String
  googleId            String?
  currentSessionId    String?
  image               String?
  emailVerified       DateTime?
  appointments        Agendamento[]
  BookableSlot        BookableSlot[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[] // Relação com tokens de verificação
  lastLogin           DateTime?            @db.Timestamptz(6)
  emailNotifications  Boolean              @default(true)
  smsNotifications    Boolean              @default(false)
  whatsappNotifications Boolean            @default(false)
}

model Agendamento {
  id             String    @id @default(uuid()) @db.Uuid
  dataHora       DateTime
  status         String
  motivoConsulta String?
  protocolCode   String    @unique @default(cuid())
  patientId      String
  user           User      @relation(fields: [patientId], references: [id])
  bookableSlotId String?   @unique
  bookableSlot   BookableSlot? @relation(fields: [bookableSlotId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model BookableSlot {
  id            String       @id @default(uuid())
  dataHora      DateTime     @db.Timestamptz(6)
  disponivel    Boolean
  userId        String?
  agendamentoId String?      @unique
  Agendamento   Agendamento?
  User          User?        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HorarioAtuacao {
  id           Int     @id @default(autoincrement())
  horaInicio   String
  horaFim      String
  diaDaSemana  Int     @default(0)
  almocoInicio String?
  almocoFim    String?
}

model HorarioBloqueado {
  id             Int      @id @default(autoincrement())
  dataHoraInicio DateTime @db.Timestamptz(6)
  dataHoraFim    DateTime @db.Timestamptz(6)
}

model DisponibilidadeDiaria {
  id           Int      @id @default(autoincrement())
  data         DateTime @unique @db.Date
  horaInicio   String
  horaFim      String
  almocoInicio String?
  almocoFim    String?
}

model Prontuario {
  id            Int         @id @default(autoincrement())
  agendamentoId String      @unique
  texto         String
}

model Recomendacao {
  id            Int         @id @default(autoincrement())
  agendamentoId String      @unique
  texto         String
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Novo model para tokens de verificação de email
model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}