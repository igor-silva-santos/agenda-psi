generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  cpf                 String               @unique
  telefone            String
  dataNascimento      DateTime             @db.Timestamptz(6)
  password            String? // Senha agora é opcional, para logins sociais
  role                String
  googleId            String?
  currentSessionId    String?
  image               String?
  emailVerified       DateTime?
  appointments        Agendamento[]
  BookableSlot        BookableSlot[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[] // Relação com tokens de verificação
  lastLogin           DateTime?            @db.Timestamptz(6)
  emailNotifications  Boolean              @default(true)
  smsNotifications    Boolean              @default(false)
  whatsappNotifications Boolean            @default(false)

  // Usado para calcular o valor de cada consulta na hora de gerar uma fatura
  valorConsulta       Float?               @default(150)

  notificacoes        Notificacao[]
  faturas             Fatura[]
  documentos          Documento[]
}

model Agendamento {
  id             String    @id @default(uuid()) @db.Uuid
  dataHora       DateTime
  status         String
  motivoConsulta String?
  protocolCode   String    @unique @default(cuid())
  patientId      String
  user           User      @relation(fields: [patientId], references: [id])
  bookableSlotId String?   @unique
  bookableSlot   BookableSlot? @relation(fields: [bookableSlotId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Faturamento
  faturaId       String?
  fatura         Fatura?   @relation(fields: [faturaId], references: [id])

  @@index([faturaId])
}

enum StatusFatura {
  RASCUNHO
  PENDENTE
  PAGO
  CANCELADO
}

model Fatura {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  status         StatusFatura  @default(PENDENTE)
  dataVencimento DateTime
  dataPagamento  DateTime?
  valorTotal     Float
  quantidadeConsultas Int?
  itens          Json          // [{ agendamentoId, data, valor, descricao }]
  observacao     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  agendamentos   Agendamento[]

  @@index([userId])
  @@index([status])
}

enum TipoNotificacao {
  FINANCEIRO
  RECOMENDACAO
  DOCUMENTO
  SISTEMA
}

model Notificacao {
  id                   String          @id @default(uuid())
  tipo                 TipoNotificacao
  mensagem             String
  lida                 Boolean         @default(false)
  linkRedirecionamento String?
  dataCriacao          DateTime        @default(now())

  userId               String
  user                 User            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([lida])
}

model AuditLog {
  id          String   @id @default(uuid())
  acao        String   // 'CRIAR' | 'ATUALIZAR' | 'DELETAR' | 'CANCELAR' | 'PAGAR' | 'ENVIAR' | 'ASSINAR' | 'SISTEMA'
  entidade    String   // 'Usuario' | 'Agendamento' | 'Fatura' | 'Documento'
  entidadeId  String?
  descricao   String
  dadosAntes  Json?
  dadosDepois Json?
  autorId     String?
  autorNome   String?
  autorTipo   String?  // 'ADMIN' | 'PACIENTE' | 'SISTEMA'
  ip          String?
  createdAt   DateTime @default(now())

  @@index([entidade])
  @@index([createdAt])
  @@index([autorId])
}

model Documento {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])

  token            String    @unique @default(cuid())
  expiresAt        DateTime

  tipoDocumento    String    // "TERMO_CONSENTIMENTO" | "OUTRO"
  conteudoHtml     String

  assinado         Boolean   @default(false)
  assinadoEm       DateTime?
  ipAssinatura     String?
  cpfConfirmado    String?
  imagemAssinatura String?   // base64 PNG da assinatura

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
  @@index([assinado])
}

model BookableSlot {
  id            String       @id @default(uuid())
  dataHora      DateTime     @db.Timestamptz(6)
  disponivel    Boolean
  userId        String?
  agendamentoId String?      @unique
  Agendamento   Agendamento?
  User          User?        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HorarioAtuacao {
  id           Int     @id @default(autoincrement())
  horaInicio   String
  horaFim      String
  diaDaSemana  Int     @default(0)
  almocoInicio String?
  almocoFim    String?
}

model HorarioBloqueado {
  id             Int      @id @default(autoincrement())
  dataHoraInicio DateTime @db.Timestamptz(6)
  dataHoraFim    DateTime @db.Timestamptz(6)
}

model DisponibilidadeDiaria {
  id           Int      @id @default(autoincrement())
  data         DateTime @unique @db.Date
  horaInicio   String
  horaFim      String
  almocoInicio String?
  almocoFim    String?
}

model Prontuario {
  id            Int         @id @default(autoincrement())
  agendamentoId String      @unique
  texto         String
}

model Recomendacao {
  id            Int         @id @default(autoincrement())
  agendamentoId String      @unique
  texto         String
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Novo model para tokens de verificação de email
model VerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}