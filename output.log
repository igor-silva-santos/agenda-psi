-- Habilita RLS no bucket 'avatars'
ALTER TABLE storage.objects ENABLE ROW LEVEL SECURITY;

-- Política para usuários visualizarem suas próprias fotos de perfil
CREATE POLICY "Allow authenticated users to view their own avatars"
ON storage.objects FOR SELECT
TO authenticated
USING (bucket_id = 'avatars' AND auth.uid()::text = storage.foldername(name));

-- Política para usuários fazerem upload de suas próprias fotos de perfil
CREATE POLICY "Allow authenticated users to upload their own avatars"
ON storage.objects FOR INSERT
TO authenticated
WITH CHECK (bucket_id = 'avatars' AND auth.uid()::text = storage.foldername(name));

-- Política para usuários atualizarem suas próprias fotos de perfil
CREATE POLICY "Allow authenticated users to update their own avatars"
ON storage.objects FOR UPDATE
TO authenticated
USING (bucket_id = 'avatars' AND auth.uid()::text = storage.foldername(name));

-- Política para usuários deletarem suas próprias fotos de perfil
CREATE POLICY "Allow authenticated users to delete their own avatars"
ON storage.objects FOR DELETE
TO authenticated
USING (bucket_id = 'avatars' AND auth.uid()::text = storage.foldername(name));